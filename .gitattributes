# ============================================================
# Default behavior
# ============================================================
* text=auto eol=lf

# ============================================================
# Source code
# ============================================================
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf working-tree-encoding=UTF-8
*.arrv  text eol=lf working-tree-encoding=UTF-8
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# ============================================================
# Windows-specific
# ============================================================
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ============================================================
# Binary files
# ============================================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.zip   binary
*.pdf   binary
*.xlsx  binary
*.parquet binary