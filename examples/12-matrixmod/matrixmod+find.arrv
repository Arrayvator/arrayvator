# ============================================================
# FIND + MATRIXMOD — сквозной тест на 15 строках
# ============================================================
# Задача: найти все IT-строки через find и удалить их через matrixmod.
# Сравнить с результатом deleteif.
# ============================================================

m = ["Имя",    "Отдел", "Возраст", "Город",   "Зарплата";
     "Аня",    "IT",    25,        "Москва",  85000;
     "Боб",    "HR",    32,        "Питер",   65000;
     "Света",  "IT",    28,        "Москва",  95000;
     "Гена",   "Sales", 41,        "Казань",  70000;
     "Даша",   "IT",    35,        "Питер",   88000;
     "Егор",   "HR",    22,        "Москва",  60000;
     "Жанна",  "Sales", 38,        "Казань",  82000;
     "Зина",   "IT",    45,        "Москва",  92000;
     "Игорь",  "HR",    31,        "Питер",   68000;
     "Катя",   "Sales", 27,        "Москва",  78000;
     "Лена",   "IT",    42,        "Казань",  90000;
     "Миша",   "HR",    36,        "Москва",  72000;
     "Нина",   "Sales", 33,        "Питер",   81000;
     "Олег",   "IT",    24,        "Москва",  87000;
     "Петя",   "HR",    39,        "Казань",  66000]

println("=== ИСХОДНАЯ МАТРИЦА (15 строк данных) ===")
println(m)
println("")


# ------------------------------------------------------------
# ШАГ 1: Найти все IT-строки через find(..., rows)
# ------------------------------------------------------------
println("=== ШАГ 1: find IT-строк ===")

pos = find(m[:, "Отдел"] == "IT", rows)
println("Найденные номера строк:")
print(pos)
println("")
# ОЖИДАНИЕ: [2, 4, 6, 9, 12, 15]
# (Аня, Света, Даша, Зина, Лена, Олег)


# ------------------------------------------------------------
# ШАГ 2: Удалить эти строки через matrixmod
# ------------------------------------------------------------
println("=== ШАГ 2: matrixmod(m, delete, pos) ===")

r2 = matrixmod(m, delete, pos)
println(r2)
println("")
# ОЖИДАНИЕ: остались только HR и Sales
# Имя    Отдел  Возраст  Город   Зарплата
# Боб    HR     32       Питер   65000
# Гена   Sales  41       Казань  70000
# Егор   HR     22       Москва  60000
# Жанна  Sales  38       Казань  82000
# Игорь  HR     31       Питер   68000
# Катя   Sales  27       Москва  78000
# Миша   HR     36       Москва  72000
# Нина   Sales  33       Питер   81000
# Петя   HR     39       Казань  66000


# ------------------------------------------------------------
# ШАГ 3: Сравнить с deleteif
# ------------------------------------------------------------
println("=== ШАГ 3: Сравнение с deleteif ===")

r1 = deleteif(m[:, "Отдел"] == "IT")
println("deleteif:")
println(r1)
println("")

println("Количество строк:")
println("  find + matrixmod:", lenrow(r2))
println("  deleteif:        ", lenrow(r1))
println("  Совпадает:       ", lenrow(r1) == lenrow(r2))
println("")


# ------------------------------------------------------------
# ШАГ 4: Сложное условие — удалить IT и HR
# ------------------------------------------------------------
println("=== ШАГ 4: find IT OR HR, удалить через matrixmod ===")

pos2 = find(m[:, "Отдел"] == "IT" or m[:, "Отдел"] == "HR", rows)
println("Найденные строки:")
print(pos2)
println("")
# ОЖИДАНИЕ: [2, 3, 4, 6, 7, 9, 10, 12, 13, 15]  — 10 строк

r3 = matrixmod(m, delete, pos2)
println("После удаления:")
println(r3)
println("")
# ОЖИДАНИЕ: остались только Sales (Гена, Жанна, Катя, Нина)


# ------------------------------------------------------------
# ШАГ 5: Числовое условие — удалить всех > 35 лет
# ------------------------------------------------------------
println("=== ШАГ 5: find Возраст > 35, удалить ===")

pos3 = find(m[:, "Возраст"] > 35, rows)
println("Найденные строки:")
print(pos3)
println("")
# ОЖИДАНИЕ: [5, 8, 9, 12, 13, 14, 16]
# Гена (41), Жанна (38), Зина (45), Лена (42), Миша (36), Петя (39)
# Стоп, посчитаем внимательно.
# Строка 1 — заголовок.
# Возраст > 35:
#   Гена  (41) — строка 5
#   Жанна (38) — строка 8
#   Зина  (45) — строка 9
#   Лена  (42) — строка 12
#   Миша  (36) — строка 13
#   Петя  (39) — строка 16
# Итого: [5, 8, 9, 12, 13, 16]

r4 = matrixmod(m, delete, pos3)
println("После удаления:")
println(r4)
println("")


# ------------------------------------------------------------
# ШАГ 6: Проверка — исходная матрица НЕ изменилась
# ------------------------------------------------------------
println("=== ШАГ 6: исходная m не изменилась? ===")
println("lenrow(m) =", lenrow(m), " (должно быть 16 — заголовок + 15 данных)")
println(m)
println("")


println("=== СКВОЗНОЙ ТЕСТ ЗАВЕРШЁН ===")
