# ============================================================
# FIND + MATRIXMOD — поиск "Иван" в ФИО и удаление
# ============================================================
# Задача: найти всех, у кого в ФИО встречается подстрока "Иван",
#        и удалить их через find + matrixmod.
#
# Сложность: "Иван" может быть:
#   - в фамилии:   "Иванов", "Иванова", "Иванченко"
#   - в имени:     "Иван", "Иванка"
#   - в отчестве:  "Иванович", "Ивановна"
# ============================================================

m = ["ФИО",                       "Отдел", "Возраст", "Зарплата";
     "Петров Петр Петрович",      "IT",    25,        85000;
     "Иванов Иван Иванович",      "HR",    32,        65000;
     "Сидорова Анна Сергеевна",   "IT",    28,        95000;
     "Иванов Петр Сергеевич",     "Sales", 41,        70000;
     "Кузнецова Мария Ивановна",  "IT",    35,        88000;
     "Смирнов Алексей Петрович",  "HR",    22,        60000;
     "Иванченко Ольга Ивановна",  "Sales", 38,        82000;
     "Иванов Сергей Иванович",    "IT",    45,        92000;
     "Морозов Игорь Иванович",    "HR",    31,        68000;
     "Волкова Катя Дмитриевна",   "Sales", 27,        78000;
     "Иванова Лена Ивановна",     "IT",    42,        90000;
     "Мишин Миша Иванович",       "HR",    36,        72000;
     "Никитина Нина Петровна",    "Sales", 33,        81000;
     "Иванко Иван Иванович",      "IT",    24,        87000;
     "Петрова Ольга Ивановна",    "HR",    39,        66000]

println("=== ИСХОДНАЯ МАТРИЦА (15 сотрудников) ===")
println(m)
println("")

# ------------------------------------------------------------
# ШАГ 2: find — найти всех с "Иван"
# ------------------------------------------------------------
println("=== ШАГ 2: find(m[:, 'ФИО'] == 'Иван', rows, inside) ===")

pos = find(m[:, "ФИО"] == "Иван", rows, inside)
println("Найденные номера строк:")
print(pos)
println("")

println("Совпадает с ожиданием [3, 5, 6, 8, 9, 10, 12, 13, 15, 16]:")
println("  ", len(pos) == 10, "(длина", len(pos), ")")
println("")


# ------------------------------------------------------------
# ШАГ 3: Удалить найденные строки
# ------------------------------------------------------------
println("=== ШАГ 3: matrixmod(m, delete, pos) ===")

r = matrixmod(m, delete, pos)
println(r)
println("")

# ОЖИДАНИЕ: остались только те, кто НЕ содержит "Иван":
# Петров Петр Петрович
# Сидорова Анна Сергеевна
# Смирнов Алексей Петрович
# Волкова Катя Дмитриевна
# Никитина Нина Петровна
# = 5 сотрудников + заголовок = 6 строк

println("lenrow(r) =", lenrow(r), "(ожидание: 6)")
println("")


# ------------------------------------------------------------
# ШАГ 4: Проверка — в оставшихся НЕТ "Иван"
# ------------------------------------------------------------
println("=== ШАГ 4: проверка — оставшиеся НЕ содержат 'Иван' ===")

# Ищем "Иван" среди оставшихся
pos_check = find(r[:, "ФИО"] == "Иван", rows, inside)
println("Найдено 'Иван' среди оставшихся:")
print(pos_check)
println("")

# ОЖИДАНИЕ: пустой вектор (никого)
println("Пусто (0 элементов):", len(pos_check) == 0)
println("")


# ------------------------------------------------------------
# ШАГ 5: Игнорирование регистра — "иван" строчными
# ------------------------------------------------------------
println("=== ШАГ 5: find с 'иван' (строчными), inside, ignore ===")

pos2 = find(m[:, "ФИО"] == "иван", rows, inside, ignore)
println("Найденные строки:")
print(pos2)
println("")

# ОЖИДАНИЕ: то же самое [3, 5, 6, 8, 9, 10, 12, 13, 15, 16]
println("Совпадает с шагом 2:", len(pos2) == len(pos))
println("")


# ------------------------------------------------------------
# ШАГ 6: Более узкая подстрока — только "Иванов"
# ------------------------------------------------------------
println("=== ШАГ 6: только 'Иванов' (не 'Иван') ===")

pos3 = find(m[:, "ФИО"] == "Иванов", rows, inside)
println("Найденные строки:")
print(pos3)
println("")

# Разбор вручную:
# Строка 3:  Иванов Иван Иванович   — ДА ("Иванов")
# Строка 5:  Иванов Петр Сергеевич  — ДА
# Строка 8:  Иванченко Ольга Ивановна — ДА ("Ивановна")
# Строка 9:  Иванов Сергей Иванович — ДА ("Иванов" + "Иванович")
# Строка 12: Иванова Лена Ивановна  — ДА ("Иванова", "Ивановна")
# Строка 15: Иванко Иван Иванович   — ДА ("Иванович")
# Строка 16: Петрова Ольга Ивановна — ДА
#
# НЕ попадут: строки 6, 10, 13 — там "Ивановна"/"Иванович" (тоже содержит "Иванов")
# СТОП: "Ивановна" содержит "Иванов"! Значит, попадут.
#
# ОЖИДАНИЕ: [3, 5, 8, 9, 12, 15, 16]
# (те, где есть "Иванов" как подстрока)
# НЕ попадут: 6 (только "Ивановна"), 10 (только "Иванович"), 13 (только "Иванович")
#
# Стоп, "Ивановна" содержит "Иванов" — да. Значит, попадут ВСЕ, где есть
# "Иванов", "Иванова", "Ивановна", "Иванович".
#
# Разберём ещё раз:
# Строка 6:  Кузнецова Мария Ивановна — "Ивановна" содержит "Иванов" → ДА
# Строка 10: Морозов Игорь Иванович   — "Иванович" содержит "Иванов" → ДА
# Строка 13: Мишин Миша Иванович      — ДА
#
# ОЖИДАНИЕ: [3, 5, 6, 8, 9, 10, 12, 13, 15, 16] — те же 10 строк!

println("Совпадает с шагом 2:", len(pos3) == len(pos))
println("")


# ------------------------------------------------------------
# ШАГ 7: Ещё уже — только "Иванович" (отчество мужчин)
# ------------------------------------------------------------
println("=== ШАГ 7: только 'Иванович' ===")

pos4 = find(m[:, "ФИО"] == "Иванович", rows, inside)
println("Найденные строки:")
print(pos4)
println("")

# Разбор вручную:
# Строка 3:  Иванов Иван Иванович       — ДА
# Строка 8:  Иванченко Ольга Ивановна   — нет ("Ивановна")
# Строка 9:  Иванов Сергей Иванович     — ДА
# Строка 10: Морозов Игорь Иванович     — ДА
# Строка 12: Иванова Лена Ивановна      — нет
# Строка 13: Мишин Миша Иванович        — ДА
# Строка 15: Иванко Иван Иванович       — ДА
# Строка 16: Петрова Ольга Ивановна     — нет
#
# ОЖИДАНИЕ: [3, 9, 10, 13, 15] — 5 строк


# ------------------------------------------------------------
# ШАГ 8: Сложное — "Иван" AND Возраст > 30
# ------------------------------------------------------------
println("=== ШАГ 8: 'Иван' AND Возраст > 30 ===")

pos5 = find(m[:, "ФИО"] == "Иван" and m[:, "Возраст"] > 30, rows, inside)
println("Найденные строки:")
print(pos5)
println("")

# Разбор вручную (только те, где есть "Иван" и возраст > 30):
# Строка 3:  Иванов Иван Иванович     (32) — ДА
# Строка 5:  Иванов Петр Сергеевич    (41) — ДА
# Строка 6:  Кузнецова Мария Ивановна (35) — ДА
# Строка 8:  Иванченко Ольга Ивановна (38) — ДА
# Строка 9:  Иванов Сергей Иванович   (45) — ДА
# Строка 10: Морозов Игорь Иванович   (31) — ДА
# Строка 12: Иванова Лена Ивановна    (42) — ДА
# Строка 13: Мишин Миша Иванович      (36) — ДА
# Строка 15: Иванко Иван Иванович     (24) — НЕТ (24 < 30)
# Строка 16: Петрова Ольга Ивановна   (39) — ДА
#
# ОЖИДАНИЕ: [3, 5, 6, 8, 9, 10, 12, 13, 16] — 9 строк


# ------------------------------------------------------------
# ШАГ 9: Исходная матрица не изменилась?
# ------------------------------------------------------------
println("=== ШАГ 9: исходная m не изменилась? ===")
println("lenrow(m) =", lenrow(m), "(должно быть 16)")
println("")


println("=== ТЕСТ ФИО ЗАВЕРШЁН ===")
