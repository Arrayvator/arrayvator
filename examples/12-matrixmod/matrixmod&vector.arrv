# ============================================================
# MATRIXMOD С ВЕКТОРОМ ПОЗИЦИЙ
# ============================================================

# Исходная матрица (строка 1 — заголовок)
m = ["Имя", "Отдел", "Зарплата";
     "Аня", "IT",    85000;
     "Боб", "HR",    65000;
     "Света","IT",   95000;
     "Гена","Sales", 70000;
     "Даша","IT",    88000;
     "Егор","HR",    72000]

println("Исходная:")
println(m)
println("")


# ------------------------------------------------------------
# ТЕСТ 1: delete через вектор-переменную
# ------------------------------------------------------------
println("=== 1. delete через вектор [2, 4, 6] ===")

pos1 = [2, 4, 6]
println("Вектор позиций:")
print(pos1)
println("")

r = matrixmod(m, delete, pos1)
println("Результат:")
println(r)
println("")

# ОЖИДАНИЕ: удалены Аня (2), Света (4), Егор (6)
# Имя   Отдел  Зарплата
# Боб   HR     65000
# Гена  Sales  70000
# Даша  IT     88000


# ------------------------------------------------------------
# ТЕСТ 2: delete через вектор, созданный функцией
# ------------------------------------------------------------
println("=== 2. delete через range(2:4) ===")

r = matrixmod(m, delete, range(2:4))
println(r)
println("")

# ОЖИДАНИЕ: удалены Аня (2), Боб (3), Света (4)
# Имя    Отдел  Зарплата
# Гена   Sales  70000
# Даша   IT     88000
# Егор   HR     72000


# ------------------------------------------------------------
# ТЕСТ 3: insert через вектор
# ------------------------------------------------------------
println("=== 3. insert через вектор [2, 5], after ===")

pos2 = [2, 5]
r = matrixmod(m, insert, pos2, after)
println(r)
println("")

# ОЖИДАНИЕ: после Ани (2) и после Гены (5)
# Имя    Отдел  Зарплата
# Аня    IT     85000
# None   None   None      ← после Ани
# Боб    HR     65000
# Света  IT     95000
# Гена   Sales  70000
# None   None   None      ← после Гены
# Даша   IT     88000
# Егор   HR     72000


# ------------------------------------------------------------
# ТЕСТ 4: duplicate через вектор
# ------------------------------------------------------------
println("=== 4. duplicate через вектор [2, 4], after ===")

pos3 = [2, 4]
r = matrixmod(m, duplicate, pos3, after)
println(r)
println("")

# ОЖИДАНИЕ: копия Ани после Ани, копия Светы после Светы


# ------------------------------------------------------------
# ТЕСТ 5: clear через вектор
# ------------------------------------------------------------
println("=== 5. clear через вектор [3, 5] ===")

pos4 = [3, 5]
r = matrixmod(m, clear, pos4)
println(r)
println("")

# ОЖИДАНИЕ: обнулены Боб (3) и Гена (5)


# ------------------------------------------------------------
# ТЕСТ 6: keep через вектор
# ------------------------------------------------------------
println("=== 6. keep через вектор [1, 2, 4, 6] ===")

pos5 = [1, 2, 4, 6]
r = matrixmod(m, keep, pos5)
println(r)
println("")

# ОЖИДАНИЕ: заголовок + Аня + Света + Егор


# ------------------------------------------------------------
# ТЕСТ 7: вектор из переменной, вычисленной через range
# ------------------------------------------------------------
println("=== 7. delete через range(2:lenrow(m)) ===")

# Удалить ВСЁ, кроме заголовка
n = lenrow(m)
pos6 = range(2:n)
println("Вектор позиций (2..", n, "):")
print(pos6)
println("")

r = matrixmod(m, delete, pos6)
println("Результат:")
println(r)
println("")

# ОЖИДАНИЕ: только заголовок


# ------------------------------------------------------------
# ТЕСТ 8: пустой вектор
# ------------------------------------------------------------
println("=== 8. delete с пустым вектором [] ===")

pos7 = []
r = matrixmod(m, delete, pos7)
println(r)
println("")

# ОЖИДАНИЕ: матрица без изменений


# ------------------------------------------------------------
# ТЕСТ 9: вектор с одним элементом
# ------------------------------------------------------------
println("=== 9. delete через [3] ===")

pos8 = [3]
r = matrixmod(m, delete, pos8)
println(r)
println("")

# ОЖИДАНИЕ: удалён Боб (3). Должно совпасть с matrixmod(m, delete, 3).


# ------------------------------------------------------------
# ТЕСТ 10: вектор с дубликатами
# ------------------------------------------------------------
println("=== 10. delete через [2, 2, 4, 4] ===")

pos9 = [2, 2, 4, 4]
r = matrixmod(m, delete, pos9)
println(r)
println("")

# ОЖИДАНИЕ: удалены только 2 и 4 (дубликаты игнорируются через set)
# Имя    Отдел  Зарплата
# Боб    HR     65000
# Гена   Sales  70000
# Даша   IT     88000
# Егор   HR     72000


# ------------------------------------------------------------
# ТЕСТ 11: вектор-столбец (2D)
# ------------------------------------------------------------
println("=== 11. delete через вектор-столбец ===")

# Вектор-столбец: [[2], [4]]
# В ArrayVator такой вектор создаётся через срез матрицы
tmp = ["X"; 2; 4]                    # это обычный вектор [2, 4]
# Для чистоты — срез столбца из другой матрицы
pos_src = ["P"; 2; 4; 5]
pos_col = pos_src[:, "P"]            # вектор [2, 4, 5]

println("Вектор-срез:")
print(pos_col)
println("")

r = matrixmod(m, delete, pos_col)
println(r)
println("")

# ОЖИДАНИЕ: удалены Аня (2), Света (4), Гена (5)
# Имя   Отдел  Зарплата
# Боб   HR     65000
# Даша  IT     88000
# Егор  HR     72000


# ------------------------------------------------------------
# ТЕСТ 12: вектор с last N
# ------------------------------------------------------------
println("=== 12. delete с вектором last N ===")

# Проверить, что _add умеет 'last N'
pos10 = ["last 2"]     # вектор из одной строки
r = matrixmod(m, delete, pos10)
println(r)
println("")

# ОЖИДАНИЕ: удалены Даша и Егор
# (если _add обрабатывает 'last N' из строк)


# ------------------------------------------------------------
# ТЕСТ 13: вектор с end
# ------------------------------------------------------------
println("=== 13. delete с вектором [end] ===")

pos11 = ["end"]
r = matrixmod(m, delete, pos11)
println(r)
println("")

# ОЖИДАНИЕ: удалён Егор (последняя строка)


# ------------------------------------------------------------
# ТЕСТ 14: вектор смешанный — числа и строки
# ------------------------------------------------------------
println("=== 14. delete с [2, last 1] ===")

pos12 = [2, "last 1"]
r = matrixmod(m, delete, pos12)
println(r)
println("")

# ОЖИДАНИЕ: удалены Аня (2) и Егор (последняя строка)


println("=== ВСЕ ТЕСТЫ MATRIXMOD С ВЕКТОРОМ ЗАВЕРШЕНЫ ===")
